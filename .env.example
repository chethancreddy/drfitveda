SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Payment gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@drfitveda.com

# App config
NEXT_PUBLIC_APP_NAME=Dr Fit Veda
CRON_SECRET=your-cron-secret

# Video Consultations & Training (Zoho Meeting)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MEETING_API_URL=https://meeting.zoho.com/api/v2

# Email OTP Authentication (Powered by MSG91 Email API — No DLT Required)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_EMAIL_TEMPLATE_ID=your-msg91-email-template-id
MSG91_FROM_EMAIL=care@drfitveda.com
MSG91_FROM_NAME=Dr Fit Veda
MSG91_DOMAIN=drfitveda.com

# WhatsApp OTP Authentication (Powered by MSG91 WhatsApp API)
# MSG91_WHATSAPP_NUMBER: Your integrated WhatsApp Business phone number on MSG91 (e.g. 17111240135)
MSG91_WHATSAPP_NUMBER=17111240135
# Option A: Meta-approved WhatsApp Authentication template name
MSG91_WHATSAPP_TEMPLATE_NAME=otp_verification
# Option B: MSG91 Campaign / SendOTP v5 Template ID
# MSG91_WHATSAPP_OTP_TEMPLATE_ID=your-msg91-whatsapp-otp-template-id
MSG91_WHATSAPP_LANG=en

# Future Mobile SMS OTP (Pending TRAI DLT Registration)
# MSG91_OTP_TEMPLATE_ID=your-msg91-otp-template-id
